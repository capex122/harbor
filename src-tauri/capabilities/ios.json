{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ios",
  "description": "Harbor iOS application capabilities",
  "platforms": ["iOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "harbor-mpv:default",
    "os:default",
    "dialog:default",
    "fs:default",
    "deep-link:default",
    "process:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*:*/**" }, { "url": "http://*:*/**" }]
    }
  ]
}
